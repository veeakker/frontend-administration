{{page-title "Show"}}

<div class="container">
  <Ux::PageHeader @model={{@model}} @kind="show" />

  <div class="row">
    <Ux::DetailsCard @editable={{false}} @resource={{@model}} class="col-12">
      <:title>Details</:title>
      <:body as |C|>
        <C.Property @property="label" @label="Name" />
        <C.Property @property="slug" @label="URL slug" />
        <C.Dt>Custom CSS</C.Dt>
        <C.Dd><pre><code>{{@model.style}}</code></pre></C.Dd>
      </:body>
    </Ux::DetailsCard>
  </div>
  <div class="row">
    <Ux::DetailsCard @editable={{false}} @resource={{@model}} class="col-12">
      <:title>Images</:title>
      <:body as |C|>
        <C.Property @property="logo" @label="Logo" />
        <C.Property @property="topImage" @label="Top image" />
        <C.Property @property="placeholderImage" @label="Placeholder image" />
      </:body>
    </Ux::DetailsCard>
  </div>
  <div class="row">
    <Ux::DetailsCard @editable={{false}} @resource={{@model}} class="col-12">
      <:title>Delivery locations</:title>
      <:body as |C|>
        <C.Property @property="deliveryPlaces" @renderLabel={{false}} />
      </:body>
    </Ux::DetailsCard>
  </div>
</div>

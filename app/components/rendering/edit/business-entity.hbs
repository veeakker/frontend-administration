Current: {{get (get @resource @property) "label"}}

{{#let (find-all 'businessEntity') as |allBusinessEntities|}}
  {{#if allBusinessEntities.isLoading}}
    ... loading ...
  {{else if allBusinessEntities.isError}}
    {{allBusinessEntities.error}}
  {{else}}
    <select
      {{on "change" (e/pipe (e/str-val) this.onChange)}}
      id={{or @id (gen-id)}}
      class="form-control"
      name="business-entity"
    >
      {{#each allBusinessEntities.records as |businessEntity|}}
        {{#if (eq businessEntity.uri (get (get @resource @property) "uri"))}}
          <option selected value={{businessEntity.id}}>{{businessEntity.label}}</option>
        {{else}}
          <option value={{businessEntity.id}}>{{businessEntity.label}}</option>
        {{/if}}
      {{/each}}
    </select>
  {{/if}}
{{/let}}

<BsButton type="button" {{on "click" @exitEditing}}>Done</BsButton>